cabal-version:      2.4
name:               hiss
version:            0.1.0.0
synopsis:           KISS package manager implemented in Haskell
build-type:         Simple
license:            BSD-3-Clause

executable hiss
  main-is:          Main.hs
  hs-source-dirs:   .
  other-modules:
      Kiss
      Kiss.Alternatives
      Kiss.Build
      Kiss.Env
      Kiss.File
      Kiss.FS
      Kiss.Glob
      Kiss.Hook
      Kiss.Install
      Kiss.Manifest
      Kiss.OS
      Kiss.Package
      Kiss.Search
      Kiss.Source
      Kiss.Update
      Kiss.Util
  build-depends:
      base >=4.12 && <5,
      directory,
      process
  default-language: Haskell2010
  ghc-options:      -O1 -Wall -Wno-name-shadowing -Wno-unused-do-bind
